{
    "name": "@anusornneal/chat-relay",
    "version": "1.2.0",
    "description": "Zero-checkout remote MCP agent for ChatGPT with terminal, filesystem, process, multi-user, and multi-agent support.",
    "type": "module",
    "bin": {
        "chat-relay": "bin/chat-relay.js"
    },
    "files": [
        "bin/",
        "cli/",
        "agent/",
        "README.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "start": "node bin/chat-relay.js remote",
        "remote": "node bin/chat-relay.js remote",
        "login": "node bin/chat-relay.js login",
        "logout": "node bin/chat-relay.js logout",
        "status": "node bin/chat-relay.js status",
        "dev": "wrangler dev",
        "dev:test": "wrangler dev --local --port 8790 --var AGENT_TOKEN:test-agent --var CALLER_TOKEN:test-caller --var ADMIN_TOKEN:test-admin --var OPENAI_APPS_CHALLENGE:test-openai-apps-challenge",
        "deploy": "wrangler deploy",
        "agent": "node --env-file-if-exists=.dev.vars agent/local-agent.mjs",
        "admin": "node scripts/admin.mjs",
        "test:terminal": "node test/mcp-terminal-smoke.mjs",
        "test:stability": "node --experimental-strip-types test/relay-stability-smoke.mjs",
        "test:platform": "node test/platform-smoke.mjs",
        "test:full": "node test/multiuser-smoke.mjs",
        "test:device-auth": "node test/device-auth-smoke.mjs",
        "test:zero-checkout": "node test/zero-checkout-smoke.mjs",
        "verify:publish": "npm run verify:review && node scripts/verify-publish.mjs && npx wrangler deploy --dry-run && npm audit --omit=dev",
        "prepublishOnly": "npm run verify:publish",
        "test:oauth": "node test/oauth-smoke.mjs",
        "test:usage": "node test/usage-smoke.mjs",
        "test:usage-storage": "node test/usage-storage.test.mjs",
        "test:admin-api": "node test/admin-api-smoke.mjs",
        "test:admin-auth": "node test/admin-auth-smoke.mjs",
        "test:dashboard": "node test/dashboard-smoke.mjs",
        "test:dashboard-timers": "node test/dashboard-timers.test.mjs",
        "test:quota": "node test/quota-smoke.mjs",
        "test:ops": "node test/ops-smoke.mjs",
        "test:desktop": "node test/mcp-desktop-smoke.mjs",
        "test:device-management": "node test/device-management-smoke.mjs",
        "test:submission": "node test/submission-smoke.mjs",
        "test:agent-state": "node --experimental-strip-types --test test/agent-state.test.mjs",
        "test:tui": "node --test test/cli-tui.test.mjs",
        "test:config-security": "node --test test/config-security.test.mjs",
        "test:self-update": "node --test test/self-update.test.mjs test/agent-lifecycle-upgrade.test.mjs",
        "test:budget": "node --test test/relay-health.test.mjs test/usage-budget.test.mjs",
        "test:soak": "node test/soak-smoke.mjs",
        "test:hardening": "npm run test:tui && npm run test:config-security && npm run test:self-update && npm run test:budget && node --test test/connection-generation.test.mjs && npm run test:agent-state && node test/heartbeat-ack-watchdog.test.mjs && npm run test:usage-storage && npm run test:learn && npm run test:learn-bootstrap && npm run test:soak",
        "verify:review": "node scripts/verify-review-artifacts.mjs",
        "test:learn": "node test/learning-smoke.mjs",
        "test:learn-bootstrap": "node test/learning-bootstrap-smoke.mjs"
    },
    "dependencies": {
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/server": "^2.0.0",
        "agents": "^0.24.0",
        "esbuild": "^0.28.1",
        "wrangler": "^4.143.0",
        "zod": "^4.6.5"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anusornNeal/chat-relay.git"
    },
    "bugs": {
        "url": "https://github.com/anusornNeal/chat-relay/issues"
    },
    "homepage": "https://github.com/anusornNeal/chat-relay#readme",
    "keywords": [
        "chatgpt",
        "mcp",
        "remote-agent",
        "terminal",
        "cloudflare",
        "cli"
    ]
}
