# Cloudflare Worker URL
RELAY_URL=https://chat-relay.example.workers.dev

# Local agent identity
AGENT_ID=default
AGENT_NAME=Primary PC
AGENT_TOKEN=replace-with-agent-token

# Local capabilities
TERMINAL_ENABLED=1
DESKTOP_ENABLED=0
ALLOWED_ROOTS=C:\Users\you\Projects

# Owner/admin values are only needed on the machine used to administer the relay
CALLER_TOKEN=replace-with-owner-user-token
ADMIN_TOKEN=replace-with-admin-token
OPENAI_APPS_CHALLENGE=

# Google dashboard login (Worker configuration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://chat-relay.example.workers.dev/admin/google/callback
