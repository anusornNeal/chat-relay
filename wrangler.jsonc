{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "vars": {
    "GOOGLE_CLIENT_ID": "56931025855-dqcdmdib96ac7jqs5k5gek287plsblqf.apps.googleusercontent.com",
    "PUBLIC_BASE_URL": "https://chat-relay.anusorn-hank.workers.dev"
  },
  "assets": {
    "directory": "./dashboard",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "Relay" },
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "USAGE", "class_name": "Usage" },
      { "name": "AUDIT", "class_name": "Audit" },
      { "name": "DASHBOARD", "class_name": "DashboardHub" },
      { "name": "LEARNING", "class_name": "Learning" }
    ]
  },
  "secrets": {
    "required": ["ADMIN_TOKEN", "AGENT_TOKEN", "CALLER_TOKEN"]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] },
    { "tag": "v3", "new_sqlite_classes": ["Usage"] },
    { "tag": "v4", "new_sqlite_classes": ["Audit"] },
    { "tag": "v5", "new_sqlite_classes": ["DashboardHub"] },
    { "tag": "v6", "new_sqlite_classes": ["Learning"] }
  ]
}
